<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KonkonMatcha.Client.MainPage"
             BackgroundColor="#F6F4E9">
    <Grid RowDefinitions="58,*">
        <Grid Grid.Row="0" Padding="14,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="9" BackgroundColor="#173F2A">
            <Border WidthRequest="34" HeightRequest="34" Stroke="#87A675" StrokeShape="RoundRectangle 17" BackgroundColor="#E8EEDC"><Label Text="茶" TextColor="#173F2A" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center"><Label Text="KŌN-KŌN" TextColor="#F6F4E9" FontSize="12" FontAttributes="Bold" CharacterSpacing="2" /><Label x:Name="StatusLabel" Text="SECURE CLIENT" TextColor="#A9C39A" FontSize="9" /></VerticalStackLayout>
            <Button Grid.Column="2" Text="←" Clicked="OnBackClicked" BackgroundColor="#315B40" Padding="12,5" SemanticProperties.Description="Go back" />
            <Button Grid.Column="3" Text="↻" Clicked="OnReloadClicked" BackgroundColor="#315B40" Padding="12,5" SemanticProperties.Description="Reload workspace" />
            <Button Grid.Column="4" Text="Server" Clicked="OnChangeServerClicked" BackgroundColor="#DCE8CF" TextColor="#173F2A" Padding="13,5" />
        </Grid>

        <WebView x:Name="Workspace" Grid.Row="1" IsVisible="False" Navigating="OnNavigating" Navigated="OnNavigated" />

        <Grid x:Name="ConnectPanel" Grid.RowSpan="2" Padding="24" BackgroundColor="#F6F4E9">
            <Border MaximumWidthRequest="650" Padding="34" Stroke="#CBD7C4" StrokeShape="RoundRectangle 18" BackgroundColor="#FFFEF8" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="17">
                    <Border WidthRequest="64" HeightRequest="64" Stroke="#759767" StrokeShape="RoundRectangle 32" BackgroundColor="#E8EEDC" HorizontalOptions="Start"><Label Text="茶" TextColor="#173F2A" FontSize="27" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                    <Label Text="Connect your ledger." TextColor="#173F2A" FontSize="38" FontAttributes="Bold" />
                    <Label Text="Use the official Kōn-Kōn service or a compatible HTTPS deployment. The client never stores database credentials or API secrets." TextColor="#68776B" FontSize="13" LineHeight="1.4" />
                    <VerticalStackLayout Spacing="6"><Label Text="SERVICE URL" TextColor="#527A4D" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5" /><Border Padding="12,4" Stroke="#C7D1C3" StrokeShape="RoundRectangle 9" BackgroundColor="#FFFFFF"><Entry x:Name="EndpointEntry" Keyboard="Url" ClearButtonVisibility="WhileEditing" Placeholder="https://your-accounting-site.example" TextColor="#173F2A" /></Border></VerticalStackLayout>
                    <Label x:Name="ConnectionError" IsVisible="False" TextColor="#934650" FontSize="12" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Text="Only compatible /api/setup endpoints are accepted." TextColor="#7A887D" FontSize="10" VerticalTextAlignment="Center" /><Button x:Name="ConnectButton" Grid.Column="1" Text="Verify &amp; connect" Clicked="OnConnectClicked" BackgroundColor="#173F2A" TextColor="#FFFFFF" Padding="20,11" /></Grid>
                    <ActivityIndicator x:Name="Connecting" IsVisible="False" IsRunning="False" Color="#527A4D" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
