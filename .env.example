# MongoDB Atlas. Use a mongodb+srv URI when possible.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="konkon_matcha_accounting"
# Keeps this app isolated if the MongoDB database is shared with another project.
MONGODB_COLLECTION_PREFIX="konkon_"

# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Dedicated stable HMAC key for exact member-ID lookup. Set before storing member IDs and do not rotate without a migration plan.
IDENTITY_LOOKUP_SECRET="replace-with-a-different-32-plus-character-secret"

# Required before enabling provider-verified online transfers or wallets.
# The generic secret is a fallback; production integrations should prefer one different 32+ character secret per provider.
PAYMENT_WEBHOOK_SECRET="replace-with-a-different-32-plus-character-secret"
# PAYMENT_WEBHOOK_SECRET_PAYNOW="replace-with-a-provider-specific-32-plus-character-secret"
# PAYMENT_WEBHOOK_SECRET_DUITNOW="replace-with-a-provider-specific-32-plus-character-secret"
# PAYMENT_WEBHOOK_SECRET_TNG="replace-with-a-provider-specific-32-plus-character-secret"
# PAYMENT_WEBHOOK_SECRET_GRABPAY="replace-with-a-provider-specific-32-plus-character-secret"

# Optional public app URL, for example https://accounting.konkonmatcha.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
