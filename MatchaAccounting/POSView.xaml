<UserControl x:Class="MatchaAccounting.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#222">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 商品列表 -->
        <ItemsControl x:Name="icProducts" Grid.Column="0"
                      Background="#333" Foreground="#A8A8A8"
                      Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="150" Height="180" Margin="5"
                            Click="btnProduct_Click"
                            Style="{StaticResource ProductButtonStyle}">
                        <StackPanel>
                            <Image Source="{Binding ImagePath}" Width="120" Height="120"/>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                       TextAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Price, StringFormat=C2}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 订单详情 -->
        <StackPanel Grid.Column="1" Width="350" Margin="10">
            <TextBlock Text="Order Details" FontSize="20" FontWeight="Bold" Foreground="#A8A8A8" HorizontalAlignment="Center"/>

            <!-- 订单列表 -->
            <ListBox x:Name="lbOrderItems" Background="#333" Foreground="#A8A8A8" Height="250">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="180"/>
                            <TextBlock Text="{Binding Quantity}" Width="50"/>
                            <TextBlock Text="{Binding TotalPrice, StringFormat=C2}" Width="100"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 会员信息 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="IC:" Foreground="#A8A8A8"/>
                <TextBox x:Name="txtIC" Width="180" Background="#444" Foreground="#A8A8A8"/>
                <Button Content="Bind" Click="btnBindIC_Click" Background="#4CAF50" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- 总计 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Total:" Foreground="#A8A8A8" FontWeight="Bold"/>
                <TextBlock x:Name="tbTotal" Text="0.00" Foreground="#A8A8A8" FontWeight="Bold" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- 支付方式 -->
            <Label Content="Payment Method:" Foreground="#A8A8A8" Margin="0,10,0,0"/>
            <ComboBox x:Name="cbPaymentMethod" Background="#444" Foreground="#A8A8A8" Margin="0,0,0,10">
                <ComboBoxItem>Cash</ComboBoxItem>
                <ComboBoxItem>TNG</ComboBoxItem>
                <ComboBoxItem>Maybank</ComboBoxItem>
                <!-- Add more payment methods -->
            </ComboBox>

            <!-- 支付按钮 -->
            <Button Content="Payment Received" Click="btnPaymentReceived_Click" Background="#4CAF50" Foreground="White" BorderThickness="0" Margin="0,10,0,0" Height="30"/>

            <!-- Add Member Button -->
            <Button Content="Add Member" Click="btnAddMember_Click" Background="#2196F3" Foreground="White" BorderThickness="0" Margin="0,10,0,0" Height="27"/>

            <!-- Settings Button -->
            <Button Content="Settings" Click="btnSettings_Click" Background="#9E9E9E" Foreground="White" BorderThickness="0" Margin="0,10,0,0" Height="26"/>
        </StackPanel>
    </Grid>

    <UserControl.Resources>
        <Style x:Key="ProductButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Foreground" Value="#A8A8A8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
</UserControl>