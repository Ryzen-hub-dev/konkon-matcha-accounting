<Window x:Class="MatchaAccounting.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="400" Width="500"
        Background="#222" Foreground="#A8A8A8">
    <Grid>
        <StackPanel Margin="20">
            <Label Content="Company Name:" Foreground="#A8A8A8"/>
            <TextBox x:Name="txtCompanyName" Background="#444" Foreground="#A8A8A8" Margin="0,0,0,10"/>

            <Label Content="Logo Path:" Foreground="#A8A8A8"/>
            <TextBox x:Name="txtLogoPath" Background="#444" Foreground="#A8A8A8" Margin="0,0,0,10"/>

            <Label Content="Signature Path:" Foreground="#A8A8A8"/>
            <TextBox x:Name="txtSignaturePath" Background="#444" Foreground="#A8A8A8" Margin="0,0,0,10"/>

            <Button Content="Save" Click="btnSave_Click" Background="#4CAF50" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>