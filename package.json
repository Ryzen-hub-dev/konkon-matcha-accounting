{
  "name": "konkon-matcha-accounting",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "smoke:user": "node --import tsx scripts/user-smoke.ts",
    "bridge:payments": "node --import tsx scripts/local-payment-bridge.ts",
    "build:listener": "esbuild scripts/local-payment-bridge.ts --bundle --platform=node --format=cjs --target=node20 --minify --outfile=public/downloads/konkon-payment-listener.cjs && node -e globalThis.f=require('fs');globalThis.p='public/downloads/konkon-payment-listener.cjs';f.writeFileSync(p,f.readFileSync(p,'utf8').replace(/[\\x20\\t]+$/gm,''))",
    "smoke:bridge": "node --import tsx scripts/local-payment-bridge-smoke.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "3.0.3",
    "jose": "6.2.9",
    "lucide-react": "1.33.0",
    "mongodb": "7.5.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
