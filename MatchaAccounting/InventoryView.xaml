<UserControl x:Class="MatchaAccounting.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#222">

    <UserControl.Resources>
        <!-- 数据网格样式 -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#2a2a2a"/>
            <Setter Property="AlternatingRowBackground" Value="#333"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeight" Value="60"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#444"/>
            <Setter Property="VerticalGridLinesBrush" Value="#444"/>
        </Style>

        <!-- 列标题样式 -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- 现代化按钮样式 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 圆角按钮模板 -->
        <Style x:Key="RoundedButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 标签样式 -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#A8A8A8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#1a1a1a" CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🍵 Inventory Management" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="#4CAF50"/>
                    <TextBlock Text="Manage your product inventory efficiently" 
                               FontSize="12" Foreground="#A8A8A8" 
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 Refresh" 
                            Click="btnRefresh_Click"
                            Background="#FF9800" 
                            Style="{StaticResource RoundedButton}"
                            Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inventory List -->
        <Border Grid.Row="1" Background="#2a2a2a" CornerRadius="8" Padding="1" Margin="0,0,0,20">
            <DataGrid x:Name="dgInventory" 
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                <DataGrid.Columns>
                    <!-- Name Column -->
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" 
                                       Width="*" MinWidth="200"/>

                    <!-- Quantity Column -->
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" 
                                       Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Image Column -->
                    <DataGridTemplateColumn Header="Image" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#333" CornerRadius="4" Padding="2" 
                                        Width="50" Height="50" HorizontalAlignment="Center">
                                    <Image Source="{Binding ImagePath}" 
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="Actions" Width="200" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="➕" 
                                            ToolTip="Add Quantity"
                                            Click="btnAddQuantity_Click" 
                                            Background="#4CAF50" 
                                            Style="{StaticResource RoundedButton}"/>
                                    <Button Content="➖" 
                                            ToolTip="Subtract Quantity"
                                            Click="btnSubtractQuantity_Click" 
                                            Background="#F44336" 
                                            Style="{StaticResource RoundedButton}"/>
                                    <Button Content="✏️" 
                                            ToolTip="Edit Item"
                                            Click="btnEdit_Click" 
                                            Background="#2196F3" 
                                            Style="{StaticResource RoundedButton}"/>
                                    <Button Content="🗑️" 
                                            ToolTip="Delete Item"
                                            Click="btnDelete_Click" 
                                            Background="#9E9E9E" 
                                            Style="{StaticResource RoundedButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Add Item Panel -->
        <Border Grid.Row="2" Background="#1a1a1a" CornerRadius="8" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Name Input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <Label Content="Name:" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="txtName" Width="150" 
                            Style="{StaticResource ModernTextBox}" 
                            Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Quantity Input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <Label Content="Quantity:" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="txtQuantity" Width="60" 
                            Style="{StaticResource ModernTextBox}"
                            Margin="5,0,0,0" Text="0"/>
                </StackPanel>

                <!-- Image Upload -->
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <Label Content="Image:" Style="{StaticResource ModernLabel}"/>
                    <Button Content="📁 Browse" 
                            Click="btnBrowse_Click" 
                            Background="#FF9800" 
                            Style="{StaticResource RoundedButton}"
                            Margin="5,0,0,0"/>
                    <TextBlock x:Name="lblImagePath" 
                              Foreground="#A8A8A8" 
                              Margin="10,0,0,0" 
                              VerticalAlignment="Center"
                              FontSize="11" 
                              MaxWidth="150" 
                              TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Add Button -->
                <Button Content="➕ Add Item" 
                        Click="btnAdd_Click" 
                        Background="#4CAF50" 
                        Style="{StaticResource RoundedButton}"
                        Padding="15,8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>